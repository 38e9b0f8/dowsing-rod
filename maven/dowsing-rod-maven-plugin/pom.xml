<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.shkb42</groupId>
    <artifactId>dowsing-rod-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>dowsing-rod-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>Dowsing Rod Maven Plugin</name>
  <description>Finds structural refactoring opportunities (duplicated flows, strategy candidates,
    repeated validation) in Java and every other language Dowsing Rod supports, from Maven.
    Offline; no Python, Node, or .NET required.</description>

  <prerequisites>
    <maven>${maven.floor}</maven>
  </prerequisites>

  <properties>
    <resolver.version>1.4.1</resolver.version>
    <!-- Overridden by the os profiles below; the IT local repo gets this native jar. -->
    <dowsing.native.classifier>unsupported</dowsing.native.classifier>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.shkb42</groupId>
      <artifactId>dowsing-rod-java</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Provided by Maven at run time. Compiled against the oldest supported version. -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.floor}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.floor}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-api</artifactId>
      <version>${resolver.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>3.15.1</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${dowsing.repo.root}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>THIRD_PARTY_NOTICES.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <configuration>
          <goalPrefix>dowsing-rod</goalPrefix>
          <requiredJavaVersion>1.8</requiredJavaVersion>
          <requiredMavenVersion>${maven.floor}</requiredMavenVersion>
        </configuration>
        <executions>
          <execution>
            <id>help-goal</id>
            <goals>
              <goal>helpmojo</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Integration tests: real Maven builds of the projects in src/it, resolving the native
           jar for this platform from a private local repository, as users' builds will. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <configuration>
          <!-- Outside the repository on purpose: dowsing-rod looks for configuration in every
               folder above the scan target, and this repository's pyproject.toml has one. -->
          <cloneProjectsTo>${java.io.tmpdir}/dowsing-rod-it/${project.version}</cloneProjectsTo>
          <cloneClean>true</cloneClean>
          <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
          <settingsFile>src/it/settings.xml</settingsFile>
          <postBuildHookScript>verify</postBuildHookScript>
          <showErrors>true</showErrors>
          <streamLogsOnFailures>true</streamLogsOnFailures>
          <extraArtifacts>
            <extraArtifact>${project.groupId}:dowsing-rod-native:${project.version}:jar:${dowsing.native.classifier}</extraArtifact>
          </extraArtifacts>
          <filterProperties>
            <dowsing.fixtures>${dowsing.repo.root}/tests/fixtures</dowsing.fixtures>
          </filterProperties>
        </configuration>
        <executions>
          <execution>
            <id>integration-test</id>
            <goals>
              <goal>install</goal>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native-windows-x86_64</id>
      <activation>
        <os><family>windows</family><arch>amd64</arch></os>
      </activation>
      <properties><dowsing.native.classifier>windows-x86_64</dowsing.native.classifier></properties>
    </profile>
    <profile>
      <id>native-osx-x86_64</id>
      <activation>
        <os><family>mac</family><arch>x86_64</arch></os>
      </activation>
      <properties><dowsing.native.classifier>osx-x86_64</dowsing.native.classifier></properties>
    </profile>
    <profile>
      <id>native-osx-aarch_64</id>
      <activation>
        <os><family>mac</family><arch>aarch64</arch></os>
      </activation>
      <properties><dowsing.native.classifier>osx-aarch_64</dowsing.native.classifier></properties>
    </profile>
    <profile>
      <id>native-linux-x86_64</id>
      <activation>
        <os><name>linux</name><arch>amd64</arch></os>
        <file><missing>/lib/ld-musl-x86_64.so.1</missing></file>
      </activation>
      <properties><dowsing.native.classifier>linux-x86_64</dowsing.native.classifier></properties>
    </profile>
    <profile>
      <id>native-linux-aarch_64</id>
      <activation>
        <os><name>linux</name><arch>aarch64</arch></os>
        <file><missing>/lib/ld-musl-aarch64.so.1</missing></file>
      </activation>
      <properties><dowsing.native.classifier>linux-aarch_64</dowsing.native.classifier></properties>
    </profile>
    <profile>
      <id>native-linux-x86_64-musl</id>
      <activation>
        <os><name>linux</name><arch>amd64</arch></os>
        <file><exists>/lib/ld-musl-x86_64.so.1</exists></file>
      </activation>
      <properties><dowsing.native.classifier>linux-x86_64-musl</dowsing.native.classifier></properties>
    </profile>
    <profile>
      <id>native-linux-aarch_64-musl</id>
      <activation>
        <os><name>linux</name><arch>aarch64</arch></os>
        <file><exists>/lib/ld-musl-aarch64.so.1</exists></file>
      </activation>
      <properties><dowsing.native.classifier>linux-aarch_64-musl</dowsing.native.classifier></properties>
    </profile>
  </profiles>
</project>
